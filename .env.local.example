# Google Gemini API Key for Timetable & Homework Vision OCR extraction
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Clerk Authentication Keys
# Get these at: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Google Classroom → batch sync (Batch Pilots). Secret of the Web OAuth client used for Google sign-in.
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: separate key used to encrypt stored Classroom tokens (any long random string)
CLASSROOM_TOKEN_KEY=
