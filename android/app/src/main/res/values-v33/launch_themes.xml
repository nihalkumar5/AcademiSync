<?xml version="1.0" encoding="utf-8"?>
<!-- Launch themes the app picks for the NEXT launch (SplashScreen.setSplashScreenTheme, Android 13+),
     so the system splash already matches the app's own light/dark setting instead of the phone's. -->
<resources>
    <style name="LaunchLight" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="LaunchDark" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">#0C0C0D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
