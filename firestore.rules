rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Email-based checks only trust addresses Firebase has verified (Google sign-in is verified,
    // email/password sign-ups are not), so nobody can claim an admin or CR email by registering it.
    function hasVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return hasVerifiedEmail() && (
        request.auth.token.email in [
          'nihalkumar@iiitnr.edu.in',
          'nihalkumar538@gmail.com',
          'nihal88758@gmail.com',
          'nihal26302@iiitnr.edu.in',
          'kumarnihal829@gmail.com'
        ]
      );
    }

    function profileRole(data) {
      return data.get('profile', {}).get('role', 'student');
    }

    // Role stored in the caller's own profile (promotions are locked down in /users below)
    function callerRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? profileRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        : 'student';
    }

    function isAdmin() {
      return isSuperAdmin() || (isAuthenticated() && callerRole() == 'super_admin');
    }

    // Batch Pilot (CR) of a batch. The batch doc's creator/crUserIds/crEmails are the source of truth.
    function isPilotOf(batch) {
      return isAuthenticated() && (
        batch.get('creatorId', '') == request.auth.uid ||
        (batch.get('crUserIds', []) is list && request.auth.uid in batch.get('crUserIds', [])) ||
        (hasVerifiedEmail() && batch.get('creatorEmail', '') == request.auth.token.email) ||
        (hasVerifiedEmail() && batch.get('crEmails', []) is list && request.auth.token.email in batch.get('crEmails', []))
      );
    }

    // Faculty may act only on batches they have linked (profile.facultyBatchKeys mirrors facultyLinkedBatches)
    function isLinkedFacultyOf(batchKey) {
      return isAuthenticated() && callerRole() == 'faculty'
        && batchKey in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
             .get('profile', {}).get('facultyBatchKeys', []);
    }

    // A student whose own profile is joined to this batch
    function isMemberOfBatch(batchKey) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data
             .get('profile', {}).get('batchKey', '') == batchKey;
    }

    function isPilotOfBatchKey(batchKey) {
      return batchKey is string && batchKey != ''
        && exists(/databases/$(database)/documents/shared_timetables/$(batchKey))
        && isPilotOf(get(/databases/$(database)/documents/shared_timetables/$(batchKey)).data);
    }

    // Users can't promote themselves: only 'student' is self-selectable. 'cr' needs a pilot seat in the
    // batch doc (given by an admin or an existing pilot); 'faculty' and 'super_admin' are granted by an admin.
    function roleChangeAllowed(newData, oldRole) {
      let newRole = profileRole(newData);
      return newRole == oldRole
        || newRole == 'student'
        || (newRole == 'cr' && isPilotOfBatchKey(newData.get('profile', {}).get('batchKey', '')))
        || (newRole in ['faculty', 'super_admin'] && isSuperAdmin());
    }

    // Shared calendars/exams: the first sharer owns the doc; this batch's pilots and admins may update it
    function canUpdateSharedBatchDoc(batchKey) {
      return isAdmin()
        || isPilotOfBatchKey(batchKey)
        || (isAuthenticated()
          && resource.data.get('creatorId', '') == request.auth.uid
          && request.resource.data.get('creatorId', '') == request.auth.uid);
    }

    // 1. Users Collection: private to the owner (and admins). Classmates' public fields are served
    // by /api/batch/members, so FCM tokens, homework and notifications never leak.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSuperAdmin() || (isOwner(userId) && roleChangeAllowed(request.resource.data, 'student'));
      allow update: if isSuperAdmin() || (isOwner(userId) && roleChangeAllowed(request.resource.data, profileRole(resource.data)));
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // 2. Shared Batch Timetables Collection:
    // Read: Public — the "Find Your Class & Batch" search in onboarding runs before sign-in
    // Write: Admins and this batch's Pilots; faculty may change sessions/alerts; members may join/leave
    match /shared_timetables/{batchKey} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isAuthenticated() && callerRole() in ['cr', 'super_admin']);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isPilotOf(resource.data) ||
        // Faculty cancellations, reschedules, extra classes and the alerts that announce them (linked batches only)
        (isLinkedFacultyOf(batchKey) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cancelledSessions', 'cancelledSessionsMeta', 'rescheduledSessions',
          'extraSessions', 'batchAlerts', 'updatedAt'
        ])) ||
        // Joining/leaving and homework proposals
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentCount', 'members', 'lastActive', 'homeworkProposals', 'updatedAt'
        ])
      );
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.get('creatorId', '') == request.auth.uid);

      // Routines shared inside a batch. Only people in the batch (members, linked faculty, pilots, admins)
      // can see or share them; nobody edits someone else's share, and each person can only mark their own "added".
      match /shared_routines/{routineId} {
        function inThisBatch() {
          return isAdmin() || isPilotOfBatchKey(batchKey) || isLinkedFacultyOf(batchKey) || isMemberOfBatch(batchKey);
        }
        allow read: if inThisBatch();
        allow create: if inThisBatch()
          && request.resource.data.get('sharedBy', '') == request.auth.uid
          && request.resource.data.get('title', '') is string
          && request.resource.data.get('title', '').size() > 0
          && request.resource.data.get('title', '').size() <= 60
          && request.resource.data.get('addedBy', {}).size() == 0;
        allow update: if inThisBatch() && (
          (resource.data.get('sharedBy', '') == request.auth.uid
            && request.resource.data.get('sharedBy', '') == request.auth.uid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['addedBy'])
            && request.resource.data.get('addedBy', {}).diff(resource.data.get('addedBy', {})).affectedKeys()
                 .hasOnly([request.auth.uid]))
        );
        allow delete: if isAdmin() || isPilotOfBatchKey(batchKey)
          || (isAuthenticated() && resource.data.get('sharedBy', '') == request.auth.uid);
      }

      // Proposed tasks: student proposals (voted on) and faculty assignments (posted by linked faculty)
      match /proposed_tasks/{taskId} {
        function isFacultyTask(data) {
          return data.get('isFacultyAssignment', false) == true || data.get('creatorRole', '') == 'faculty';
        }
        function canManage() {
          return isAdmin() || isPilotOfBatchKey(batchKey);
        }

        allow read: if isAuthenticated();

        // Creators sign their own tasks; only linked faculty can post a faculty assignment
        allow create: if canManage() || (
          isAuthenticated()
          && request.resource.data.get('creatorId', '') == request.auth.uid
          && (!isFacultyTask(request.resource.data) || isLinkedFacultyOf(batchKey))
        );

        allow update: if canManage()
          // Creator edits their own task, but can't turn a student proposal into a faculty assignment
          || (isAuthenticated()
              && resource.data.get('creatorId', '') == request.auth.uid
              && request.resource.data.get('creatorId', '') == request.auth.uid
              && (!isFacultyTask(request.resource.data) || isFacultyTask(resource.data)))
          // Classmates vote on student proposals (their own vote only)
          || (isAuthenticated()
              && !isFacultyTask(resource.data)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['votes', 'approvalsCount', 'rejectionsCount', 'status', 'approvedAt'])
              && request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys()
                   .hasOnly([request.auth.uid]))
          // Students record that they've read a faculty assignment (their own receipt only)
          || (isAuthenticated()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readReceipts'])
              && request.resource.data.get('readReceipts', {}).diff(resource.data.get('readReceipts', {})).affectedKeys()
                   .hasOnly([request.auth.uid]));

        allow delete: if canManage()
          || (isAuthenticated() && resource.data.get('creatorId', '') == request.auth.uid);
      }
    }

    // Attendance is sensitive student data, so it is server-only: every read and write goes
    // through /api/attendance (Admin SDK, which bypasses these rules) where the caller's token,
    // faculty role and batch link are checked, versions are enforced and each change is logged.
    // No client — not even the owning faculty or an admin — can touch these documents directly.
    match /attendance/{rosterId} {
      allow read, write: if false;
      match /{rest=**} {
        allow read, write: if false;
      }
    }
    match /attendance_limits/{uid} {
      allow read, write: if false;
    }
    match /attendance_exports/{token} {
      allow read, write: if false;
    }

    // 3. Batch Pilot & CR Requests: students submit their own request as 'pending';
    // only admins can approve or reject.
    match /cr_requests/{requestId} {
      allow create: if isSuperAdmin() || (isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('status', 'pending') == 'pending');
      allow update: if isSuperAdmin() || (isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('status', 'pending') in ['pending', resource.data.get('status', 'pending')]);
      allow read, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    match /cr_applications/{appId} {
      allow create: if isSuperAdmin() || (isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('status', 'pending') == 'pending');
      allow update: if isSuperAdmin() || (isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('status', 'pending') in ['pending', resource.data.get('status', 'pending')]);
      allow read, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 4. Mess Menus:
    // Read: Public (all hostel students)
    // Create: signed-in publisher (stored as creatorId); Update/Delete: that publisher or a Super Admin.
    // Anyone else's edits are saved as their own copy under a new code (see MessView).
    match /messes/{messId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.get('creatorId', '') == request.auth.uid;
      allow update: if isSuperAdmin() || (isAuthenticated()
        && resource.data.get('creatorId', '') == request.auth.uid
        && request.resource.data.get('creatorId', '') == request.auth.uid);
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.get('creatorId', '') == request.auth.uid);
    }

    // 5. Academic Calendars & Exam Schedules shared with a batch:
    // Read: Public (all college students)
    // Create: signed-in sharer (stored as creatorId); Update: that sharer, the batch's Pilots or admins
    match /shared_calendars/{calendarKey} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.get('creatorId', '') == request.auth.uid;
      allow update: if canUpdateSharedBatchDoc(calendarKey);
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.get('creatorId', '') == request.auth.uid);
    }
    match /shared_exams/{examsKey} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.get('creatorId', '') == request.auth.uid;
      allow update: if canUpdateSharedBatchDoc(examsKey);
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.get('creatorId', '') == request.auth.uid);
    }

    // 6. Campus Spotlight (Announcements/Notices):
    // Read: Public
    // Write: Super Admin only
    match /campus_spotlight/{adId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 7. Promotional Campaigns:
    // Read: Public (to display target banners to students)
    // Write: Super Admin only, except signed-in students may bump the view/click counters by exactly 1
    match /promotional_campaigns/{campaignId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks']) &&
        request.resource.data.get('impressions', 0) is int &&
        request.resource.data.get('clicks', 0) is int &&
        request.resource.data.get('impressions', 0) - resource.data.get('impressions', 0) in [0, 1] &&
        request.resource.data.get('clicks', 0) - resource.data.get('clicks', 0) in [0, 1]
      );
    }

    // 8. Contact & Support Messages:
    // Create: only through /api/contact (Admin SDK, rate limited)
    // Read/Write/Delete: Super Admin only
    match /contact_messages/{messageId} {
      allow create: if false;
      allow read, update, delete: if isSuperAdmin();
    }

    // 9. Campus admins: which college each campus admin manages. Written only by the server
    // (/api/admin/campus-admins, super admins). The owner and super admins can read it.
    match /campus_admins/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if false;
    }

    // 10. Chats: DMs between friends (chatId = their friendship id) and plan group chats
    // (chatId = plan_{planId}). Only the server creates chats and sets members. Members read them,
    // send messages as themselves, react with their own emoji, and bump the preview + their own
    // read / delivered / typing marks.
    // A DM only accepts new messages while the two are still friends.
    match /chats/{chatId} {
      function isChatMember() {
        return isAuthenticated() && request.auth.uid in resource.data.members;
      }
      allow read: if isChatMember();
      allow create, delete: if false;
      function onlyMyKey(field) {
        return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([request.auth.uid]);
      }
      allow update: if isChatMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'reads', 'delivered', 'typing'])
        && onlyMyKey('reads') && onlyMyKey('delivered') && onlyMyKey('typing')
        && (
          !('lastMessage' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.lastMessage.by == request.auth.uid
              && request.resource.data.lastMessage.text is string
              && request.resource.data.lastMessage.text.size() <= 1000)
        );

      match /messages/{messageId} {
        function chatDoc() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function inChat() {
          return isAuthenticated() && request.auth.uid in chatDoc().members;
        }
        function canStillMessage() {
          return chatDoc().type != 'dm'
            || get(/databases/$(database)/documents/friendships/$(chatId)).data.status == 'accepted';
        }
        allow read: if inChat();
        // A photo lives in Storage under chat_photos/{chatId}/{sender}/…; the message keeps its link.
        function validImage(img) {
          return img is map
            && img.keys().hasOnly(['url', 'path', 'w', 'h'])
            && img.url is string && img.url.size() < 2000
            && img.url.matches('https://firebasestorage[.]googleapis[.]com/.*')
            && img.path is string
            && img.path.matches('chat_photos/' + chatId + '/' + request.auth.uid + '/[A-Za-z0-9_]+[.](webp|jpg)')
            && img.w is number && img.h is number;
        }
        allow create: if inChat() && canStillMessage()
          && request.resource.data.keys().hasOnly(['by', 'text', 'at', 'image'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.text.size() > 0
              || ('image' in request.resource.data && validImage(request.resource.data.image)))
          && (!('image' in request.resource.data) || validImage(request.resource.data.image))
          && request.resource.data.at == request.time;
        allow update: if inChat()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]);
        allow delete: if isAuthenticated() && resource.data.by == request.auth.uid;
      }
    }

    // Default catch-all: Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
