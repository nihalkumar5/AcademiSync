rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'nihalkumar@iiitnr.edu.in',
          'nihalkumar538@gmail.com',
          'nihal88758@gmail.com',
          'nihal26302@iiitnr.edu.in',
          'kumarnihal829@gmail.com'
        ]
      );
    }

    // 1. Users Collection: Authenticated students can read profiles to view classmates; only owners and Super Admins can write
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    // 2. Shared Batch Timetables Collection:
    // Read: Any student can view shared timetable
    // Write: Super Admins, Batch Creator, or Verified Batch Pilots
    match /shared_timetables/{batchKey} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.creatorId == request.auth.uid) ||
        ('creatorEmail' in resource.data && request.auth.token.email == resource.data.creatorEmail) ||
        ('crUserIds' in resource.data && resource.data.crUserIds is list && request.auth.uid in resource.data.crUserIds) ||
        ('crEmails' in resource.data && resource.data.crEmails is list && request.auth.token.email in resource.data.crEmails) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile.role in ['cr', 'super_admin']) ||
        // Allow joining, session status sync, cancellations, reschedules, and alert broadcasts
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentCount', 'members', 'lastActive', 'homeworkProposals', 
          'cancelledSessions', 'cancelledSessionsMeta', 'rescheduledSessions', 
          'extraSessions', 'batchAlerts', 'updatedAt'
        ])
      );
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.creatorId == request.auth.uid);

      // Subcollection for proposed tasks/homework
      match /proposed_tasks/{taskId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 3. Batch Pilot & CR Requests:
    match /cr_requests/{requestId} {
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow read, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    match /cr_applications/{appId} {
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow read, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 4. Mess Menus:
    // Read: Public (all hostel students)
    // Write: Authenticated hostel students / reps
    match /messes/{messId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. Academic Calendars:
    // Read: Public (all college students)
    // Write: Authenticated students / admins
    match /shared_calendars/{calendarKey} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. Campus Spotlight (Announcements/Notices):
    // Read: Public
    // Write: Super Admin only
    match /campus_spotlight/{adId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 7. Promotional Campaigns:
    // Read: Public (to display target banners to students)
    // Write: Super Admin only
    match /promotional_campaigns/{campaignId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 8. Contact & Support Messages:
    // Create: Anyone (public / visitors submitting messages)
    // Read/Write/Delete: Super Admin only
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // Default catch-all: Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
